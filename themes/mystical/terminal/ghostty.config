# Plasmonk Ghostty config. plasmonk writes this once and never overwrites it, so your
# edits survive updates (structure follows Ryoku's ghostty config).
#
# Ghostty applies included files after this file's own keys, so the palette below wins
# over colours set here; put colour overrides in user.conf, which loads last.

font-family = JetBrainsMono Nerd Font
font-size = 11
cursor-style = bar
window-padding-x = 10
window-padding-y = 8

# Translucency (background-opacity, background-blur) comes from plasmonk-colors below and
# follows `plasmonk opacity`; set your own in user.conf.

# Use the Plasmonk title bar (KWin decoration) instead of Ghostty's own.
window-decoration = server

# theme palette, rendered by matugen next to this file
config-file = plasmonk-colors

# your overrides; never shipped, loads last. ? = optional, no error if absent
config-file = ?user.conf
