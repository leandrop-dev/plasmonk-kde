# Plasmonk KDE color scheme, rendered by matugen from themes/mystical/templates/plasmonk.colors.
# Role mapping follows upstream JuxTheme.colors (themes/mystical/reference/), using matugen tonal palettes:
#   backgrounds (window, view, header, tooltip, panels, title bar) keep upstream's fixed dark greys so
#   they never tint with the palette; accent ~ primary 50, links ~ primary 60, selection ~ secondary 35.
# Positive (green) and Neutral (warning orange) stay fixed so their meaning survives every palette.

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

