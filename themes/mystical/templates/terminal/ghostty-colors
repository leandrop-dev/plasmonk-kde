# Plasmonk palette -> Ghostty. Rendered by matugen on `plasmonk apply`; do not edit.
# Your own settings live in ~/.config/ghostty/config (colour overrides in user.conf).
# Foreground/cursor/selection follow the palette. The background is #101010 on every palette,
# the base of the title bars and Dolphin, so at the same opacity they match; ANSI hues stay fixed so
# red still means error and green still means success on every preset.
background = #101010
background-opacity = @PLASMONK_OPACITY@
background-blur = true
foreground = {{palettes.neutral._90.hex}}
cursor-color = {{palettes.primary._70.hex}}
cursor-text = {{palettes.primary._20.hex}}
selection-background = {{palettes.secondary._35.hex}}
selection-foreground = {{palettes.neutral._99.hex}}
