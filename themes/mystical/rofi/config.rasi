/* Plasmonk rofi config, based on Mystical-Blue-Theme's rofi/config.rasi.
 * Colors come from plasmonk-colors.rasi, regenerated by `plasmonk apply`.
 * Every element state sets its own colors so active/urgent entries stay readable (upstream issue #15). */
@import "plasmonk-colors.rasi"

configuration {
    font: "JetBrainsMono Nerd Font Mono 12";
    lines: 10;
    fixed-num-lines: true;
}

* {
    background-color: transparent;
    text-color: @pm-fg;
    separatorcolor: transparent;
}

window {
    border-radius: 11px;
    border: 1px solid;
    border-color: #000000;
    background-color: @pm-bg;
    padding: 0px;
    width: 30%;
}

mainbox {
    border: 2px;
    border-color: rgba(255, 255, 255, 20%);
    border-radius: 10px;
    padding: 10px;
}

inputbar {
    children: [ entry ];
}

entry {
    placeholder: "";
    text-color: @pm-fg;
    padding: 8px 0 8px 8px;
}

listview {
    lines: 10;
}

element {
    padding: 10px 10px;
    border-radius: 5px;
    children: [ element-text, element-icon ];
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @pm-fg; }
element normal.active, element alternate.active { background-color: transparent; text-color: @pm-accent; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @pm-urgent; }
element selected.normal { background-color: @pm-selected; text-color: @pm-fg; }
element selected.active { background-color: @pm-selected; text-color: @pm-accent; }
element selected.urgent { background-color: @pm-selected; text-color: @pm-urgent; }

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

scrollbar {
    handle-color: @pm-scroll;
    handle-width: 4px;
    padding: 0;
}
